{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "feetheproducer-site",
  "account_id": "62738e2bb751720449f1cd904f6d175f",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {},
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "feetheproducer-site"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
