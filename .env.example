# Environment contract for the Clerk / Stripe / Supabase routes.
#
# Copy to .env.local and fill in from each provider's dashboard. Real values are
# never committed: .env and .env*.local are git-ignored, and this public
# repository holds no credentials.
#
# Every variable is optional. With a variable missing, the route that needs it
# answers 503 and the rest of the site is unaffected — see
# GET /api/health/integrations for what the current environment has.

# --- Clerk (accounts) ------------------------------------------------------
# Dashboard > API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Dashboard > Webhooks > the endpoint for /api/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Stripe (payments) -----------------------------------------------------
# Dashboard > Developers > API keys
STRIPE_SECRET_KEY=
# Dashboard > Developers > Webhooks > the endpoint for /api/webhooks/stripe
# Locally: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# --- Supabase (orders, entitlements) --------------------------------------
# Dashboard > Project settings > Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses row level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Printful (server-only, Fee The Producer store) ------------------------
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=18904049
