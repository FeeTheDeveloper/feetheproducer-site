# Email delivery (Resend) — powers /api/subscribe and /api/contact
# notifications. Without it, submissions are logged only.
RESEND_API_KEY=

# Optional overrides. FROM must be on a domain verified in Resend
# (https://resend.com/domains); defaults to onboarding@resend.dev until
# feetheproducer.com is verified. TO defaults to contact@feetheproducer.com.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
