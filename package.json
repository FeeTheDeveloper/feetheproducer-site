{
  "name": "feetheproducer-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "cf:build": "opennextjs-cloudflare build && node scripts/cloudflare-runtime-env.mjs",
    "cf:bootstrap": "node scripts/cloudflare-runtime-env.mjs && wrangler deploy --config wrangler.bootstrap.jsonc",
    "cf:upload": "node scripts/cloudflare-runtime-env.mjs && opennextjs-cloudflare upload",
    "cf:deploy": "node scripts/cloudflare-runtime-env.mjs && opennextjs-cloudflare deploy",
    "cf:secrets": "node scripts/cloudflare-secrets.mjs",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.mjs",
    "catalog:sync": "node scripts/sync-stripe-catalog.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.15",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "clsx": "^2.1.1",
    "next": "15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "0.0.1",
    "stripe": "^23.0.0",
    "svix": "^2.8.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@opennextjs/cloudflare": "1.20.12",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wrangler": "4.151.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
